pkgname=voidbr-enlightenment
pkgdesc="VoidBR Enlightenment Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=()  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=() # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	# --- Base do VoidBR ---
	voidbr-base-common # Base: base-config, utils, NetworkManager, firmware etc.
	voidbr-gui-common  # Apps e login manager do voidbr-enlightenment antigo (quem atualiza não perde nada)

	# --- Enlightenment ---
	enlightenment               # Desktop (puxa o efl e o xorg-server-xwayland da sessão Wayland)
	terminology                 # Terminal padrão (favorito na barra)
	xfce4-terminal              # Terminal alternativo
	rage                        # Player de vídeo/áudio EFL
	evisum                      # Monitor do sistema EFL (pacote VoidBR)
	ephoto                      # Visualizador de imagens EFL (pacote VoidBR)
	ecrire                      # Editor de texto EFL (pacote VoidBR)
	conky                       # Monitor na área de trabalho (~/.config/conky/conky.conf)
	network-manager-applet      # Rede na bandeja (o E não tem módulo do NetworkManager)
	pavucontrol                 # Mixer completo (o módulo mixer do E cobre o básico)
	voidbr-enlightenment-config # Skel e padrões (perfil VoidBR, paleta Tokyo Night, wallpaper)

	# --- Visual ---
	voidbr-tokyo-theme     # Tokyonight-Dark-Theme, Tokyonight-Dark-Icons (GTK e ícones do E)
	voidbr-wallpapers      # Papel de parede (voidbr-wallpaper.avif)
	adwaita-icon-theme     # Ícones de reserva (os Tokyonight herdam de "gnome")
	cantarell-fonts        # Fonte da interface GTK (Cantarell 11)
	dejavu-fonts-ttf       # Fonte monoespaçada (DejaVu Sans Mono 10)
	noto-fonts-ttf         # Fonte do conky
	noto-fonts-emoji
	nerd-fonts-symbols-ttf

	# --- Sessão e login ---
	sddm               # Login (o post_install ativa o sddm)
	acpid              # Eventos ACPI (tampa, botões); sem ele o E mostra "Erro de ACPI" (o post_install ativa)
	voidbr-sddm-themes # Temas do sddm VoidBR
	dbus-elogind
	polkit-elogind
	gnome-keyring      # Senhas (navegador, Wi-Fi)

	# --- X11 (sessão padrão do Enlightenment) ---
	xorg
	mesa-dri
	mesa-nouveau-dri
	mesa-vaapi

	# --- Wayland (sessão experimental do Enlightenment) ---
	xdg-desktop-portal
	xdg-desktop-portal-gtk # Seletor de arquivos e captura de tela para apps GTK/Flatpak

	# --- Áudio (PipeWire) ---
	pipewire
	wireplumber
	alsa-pipewire
	libjack-pipewire
	libspa-bluetooth # Áudio Bluetooth
	alsa-utils

	# --- Rede, Bluetooth e discos ---
	bluez   # Módulo Bluetooth do E (ebluez5)
	udisks2 # Montar pendrives no gerenciador de arquivos do E

	# --- Apps ---
	firefox            # Navegador padrão e favorito na barra
	firefox-i18n-pt-BR
	octoxbps
	gparted
	mpv
	chili-iso2usb
	voidbr-iso-writer
	voidbr-webapps
	voidbr-ai         # Assistente de IA do VoidBR (favorito na barra)
	xdg-utils
	xdg-user-dirs
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	# acpid: o Enlightenment recebe dele os eventos de ACPI (sem ele mostra "Erro de ACPI").
	# Na ISO e no instalador (chroot) o /var/service não existe e o vservice não funciona:
	# ativa direto no runsvdir padrão, como o voidbr-base-common faz.
	if [ -n "${MKISO_BUILD:-}" ] || [ -n "${VOIDBR_INSTALLER:-}" ]; then
		log "Ativando o acpid (chroot)"
		ln -snf /etc/sv/acpid /etc/runit/runsvdir/default/acpid
	else
		log "Ativando o acpid"
		/usr/local/bin/vservice add acpid --quiet || true
	fi

	if [ -n "${MKISO_BUILD:-}" ]; then
		echo "${YELLOW}[-]${RESET} Build de ISO detectado (MKISO_BUILD) — pulando."
		return 0
	fi

	if [ -z "${VOIDBR_INSTALLER:-}" ]; then
		# A cópia do skel para o usuário fica no post_install do voidbr-enlightenment-config,
		# que é o pacote que traz o skel (assim ela roda também quando só ele é atualizado).

		# Login manager: ativo = tem link em /var/service (instalado só em /etc/sv não conta).
		# Mantém o da sessão gráfica aberta (para não derrubar quem está logado); se não
		# houver sessão gráfica, mantém o primeiro ativo na ordem abaixo. Os demais ativos
		# são desativados. Se nenhum estiver ativo, ativa o sddm.
		local s srv dm manter=""
		if command -v loginctl >/dev/null 2>&1; then
			for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
				[ "$(loginctl show-session "$s" -p Class --value 2>/dev/null)" = user ] || continue
				case "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" in
				x11 | wayland) ;;
				*) continue ;;
				esac
				srv=$(loginctl show-session "$s" -p Service --value 2>/dev/null)
				case "$srv" in gdm-*) srv=gdm ;; esac
				if [ -n "$srv" ] && [ -x "/var/service/$srv/run" ]; then
					manter="$srv"
					log "Sessão gráfica aberta pelo login manager '$srv'"
					break
				fi
			done
		fi

		if [ -z "$manter" ]; then
			for dm in sddm lightdm gdm greetd lxdm; do
				if [ -x "/var/service/$dm/run" ]; then
					manter="$dm"
					break
				fi
			done
		fi

		if [ -z "$manter" ]; then
			log "Ativando o sddm"
			/usr/local/bin/vservice add sddm --quiet || true
		else
			log "Login manager '$manter' ja ativo"
			for dm in sddm lightdm gdm greetd lxdm; do
				[ "$dm" = "$manter" ] && continue
				[ -x "/var/service/$dm/run" ] || continue
				log "Desativando o login manager '$dm' (fica o '$manter')"
				/usr/local/bin/vservice rm "$dm" --quiet || true
			done
		fi
	fi

	log "${YELLOW}Instalação completa. Reinicie o sistema...${RESET}"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
